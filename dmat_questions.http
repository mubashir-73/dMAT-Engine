      "11 + B = D"
    ],
    "variables": [
      "A",
      "B",
      "C",
      "D"
    ]
  },
  "solution": {
    "answers": {
      "A": 5,
      "B": 1,
      "C": 10,
      "D": 12
    }
  }
}


### Math Question 6
POST {{questionsEndpoint}}
Content-Type: application/json

{
  "module_type": "mathematical_equations",
  "difficulty": "hard",
  "data": {
    "equations": [
      "C + D - A = 1",
      "5 * C = D",
      "13 - C = A",
      "3 * C - 1 = B"
    ],
    "variables": [
      "A",
      "B",
      "C",
      "D"
    ]
  },
  "solution": {
    "answers": {
      "A": 11,
      "B": 5,
      "C": 2,
      "D": 10
    }
  }
}


### =========================
### LATIN SQUARES
### =========================

### Latin Square Question 1
POST {{questionsEndpoint}}
Content-Type: application/json

{
  "module_type": "latin_square",
  "difficulty": 1,
  "data": {
    "type": "latin_square",
    "grid": {
      "rows": 5,
      "columns": 5,
      "cells": [
        [
          "D",
          null,
          "A",
          null,
          null
        ],
        [
          null,
          "E",
          "C",
          null,
          null
        ],
        [
          "A",
          "D",
          "?",
          "B",
          "C"
        ],
        [
          "E",
          "A",
          "B",
          null,
          "D"
        ],
        [
          null,
          null,
          null,
          "A",
          "E"
        ]
      ]
    },
    "missing_cell": {
      "row": 2,
      "column": 2
    },
    "options": [
      {
        "id": "A"
      },
      {
        "id": "B"
      },
      {
        "id": "C"
      },
      {
        "id": "D"
      },
      {
        "id": "E"
      }
    ]
  },
  "solution": {
    "correct_option": "E"
  }
}


