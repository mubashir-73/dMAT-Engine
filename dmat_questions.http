# dMAT Core Module - Question Population
# REST Client / Neovim HTTP file
#
# Mathematical Equations: 6 source-style exercises from the preparatory material.
# Latin Squares: 6 valid 5x5 test puzzles, two per difficulty.
# Figure Sequence is intentionally omitted because it requires image assets.
#
# Adjust only @baseUrl if your API is mounted under a different prefix.

@baseUrl = http://localhost:8000
@questionsEndpoint = {{baseUrl}}/api/questions

### =========================
### MATHEMATICAL EQUATIONS
### =========================

### Math Question 1
POST {{questionsEndpoint}}
Content-Type: application/json

{
  "module_type": "mathematical_equations",
  "difficulty":"easy",
  "data": {
    "equations": [
      "7 + A = 14",
      "B - 3 = A"
    ],
    "variables": [
      "A",
      "B"
    ]
  },
  "solution": {
    "answers": {
      "A": 7,
      "B": 10
    }
  }
}


### Math Question 2
POST {{questionsEndpoint}}
Content-Type: application/json

{
  "module_type": "mathematical_equations",
  "difficulty": "easy",
  "data": {
    "equations": [
      "B / 2 = A",
      "B - A = 8"
    ],
    "variables": [
      "A",
      "B"
    ]
  },
  "solution": {
    "answers": {
